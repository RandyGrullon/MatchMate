# Copia este archivo a .env.local (y pon estas mismas variables en Vercel > Settings > Environment Variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Escaneo de fotos con Gemini (Firebase AI Logic). Opcional: por defecto gemini-3.8-flash
VITE_GEMINI_MODEL=
# App Check (obligatorio para AI Logic): site key de reCAPTCHA Enterprise
VITE_RECAPTCHA_SITE_KEY=
# Solo en local: token de depuración de App Check (regístralo en Consola > App Check > Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=
