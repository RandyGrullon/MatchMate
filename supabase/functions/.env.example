# MatchMate · secretos de las Edge Functions (scan-bowling y send-push). SECRETOS: nunca en el repo ni en el chat.
#
# Cópialo a supabase/functions/.env (ya está en .gitignore), llénalo tú y súbelo a cada proyecto con:
#   npx -y supabase@2 secrets set --env-file supabase/functions/.env --project-ref REF_DEL_PROYECTO
# Después puedes borrar el .env (los secretos quedan guardados en Supabase). Paso a paso: docs/CONFIGURAR-SUPABASE.md (paso 9).
# No pongas nada que empiece con SUPABASE_: esos los pone Supabase solo.

# Clave de Google AI Studio (proyecto de Google nuevo, SIN facturación). Lectura de fotos del boliche.
GEMINI_API_KEY=

# Notificaciones: npx -y web-push generate-vapid-keys (la pública va también en VITE_VAPID_PUBLIC_KEY de la app).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: + el correo de la app, p. ej. mailto:matchmate.app@gmail.com
VAPID_SUBJECT=

# Contraseña larga al azar que usan el cron y send-push (una por proyecto; la misma va en Vault como cron_secret):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Desde dónde la app puede pedir la lectura de fotos (orígenes exactos, separados por coma).
# Prod: https://matchmate.vercel.app · staging: http://localhost:5173 y tu dirección de Preview de Vercel.
SCAN_ALLOWED_ORIGINS=
