rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Superadmins fijos (debe coincidir con src/lib/admins.ts) + cuentas con superadmin = true.
    function isFixedSuper() {
      return signedIn() && request.auth.token.email in ['admin@admin.com'];
    }
    function isSuper() {
      return isFixedSuper()
        || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('superadmin', false) == true);
    }
    function memberPath(lid) {
      return /databases/$(database)/documents/members/$(lid + '_' + request.auth.uid);
    }
    function isMember(lid) {
      return signedIn() && exists(memberPath(lid));
    }
    function role(lid) {
      return get(memberPath(lid)).data.role;
    }
    // Dueño o admin de la liga (o superadmin): administra todo lo de esa liga.
    function isLeagueAdmin(lid) {
      return isSuper() || (isMember(lid) && role(lid) in ['owner', 'admin']);
    }
    // Dueño (o superadmin): el único que da o quita permisos (admins y anotadores).
    function isLeagueOwner(lid) {
      return isSuper() || (isMember(lid) && role(lid) == 'owner');
    }
    // Anotador de un torneo sin liga: anota los juegos de todos, nada más.
    function isScorer(lid) {
      return isMember(lid)
        && get(memberPath(lid)).data.get('scorer', false) == true
        && league(lid).get('kind', 'liga') == 'torneo';
    }
    // Jugador de la liga vinculado a la cuenta (null si no tiene).
    function myPlayer(lid) {
      return isMember(lid) ? get(memberPath(lid)).data.playerId : null;
    }
    function league(lid) {
      return get(/databases/$(database)/documents/leagues/$(lid)).data;
    }
    // Liga pública: la ve cualquiera, sin login. Privada: solo sus miembros.
    function canRead(lid) {
      return league(lid).visibility == 'public' || isMember(lid) || isSuper();
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validName(n) {
      return n is string && n.size() > 0 && n.size() <= 60;
    }
    function shortText(s, max) {
      return s is string && s.size() <= max;
    }
    function validLeague(d) {
      return d.keys().hasOnly(['name', 'kind', 'visibility', 'ownerUid', 'venue', 'schedule', 'seasonStart', 'seasonEnd',
                               'contactName', 'contactPhone', 'requirePhoto', 'createdAt'])
        && validName(d.name)
        && d.get('kind', 'liga') in ['liga', 'torneo']
        && d.visibility in ['public', 'private']
        && shortText(d.venue, 80) && shortText(d.schedule, 80)
        && shortText(d.seasonStart, 10) && shortText(d.seasonEnd, 10)
        && shortText(d.contactName, 60) && shortText(d.contactPhone, 20)
        && d.requirePhoto is bool;
    }

    // ---------- Cuentas ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time;
      allow update: if (isSuper() && onlyChanged(['superadmin']) && request.resource.data.superadmin is bool)
        || (signedIn() && request.auth.uid == uid && onlyChanged(['name']) && validName(request.resource.data.name));
      allow delete: if isSuper();

      // Teléfonos de la cuenta suscritos a las notificaciones (push). Solo la cuenta los ve y los cambia;
      // el envío programado los lee con su credencial de servidor.
      match /push/{id} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'ua', 'updatedAt'])
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('^https://(fcm[.]googleapis[.]com|web[.]push[.]apple[.]com|updates[.]push[.]services[.]mozilla[.]com|[a-z0-9-]+[.]notify[.]windows[.]com)/.*')
          && request.resource.data.endpoint.size() < 1000
          && request.resource.data.p256dh is string && request.resource.data.p256dh.size() < 200
          && request.resource.data.auth is string && request.resource.data.auth.size() < 100
          && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
          && request.resource.data.updatedAt == request.time;
      }
    }

    // ---------- Ligas ----------
    match /leagues/{lid} {
      // ---- Funciones de la liga (van antes que los match: el compilador de Firebase lo exige) ----
      // Pinos válidos de un juego (0 a 300, o vacío) y de una lista de juegos (hasta 10).
      function okScore(l, i) {
        return l.size() <= i || l[i] == null || (l[i] is int && l[i] >= 0 && l[i] <= 300);
      }
      function okScores(l) {
        return l is list && l.size() <= 10
          && okScore(l, 0) && okScore(l, 1) && okScore(l, 2) && okScore(l, 3) && okScore(l, 4)
          && okScore(l, 5) && okScore(l, 6) && okScore(l, 7) && okScore(l, 8) && okScore(l, 9);
      }

      // Social: me gusta, felicitar y comentar el juego de alguien (cualquier miembro de la liga).
      // Tiene que ser de un juego que existe y decir bien de quién es (a esa persona le llega el aviso).
      function socialOk(d) {
        let entry = /databases/$(database)/documents/leagues/$(lid)/entries/$(d.entryId);
        return isMember(lid)
          && d.uid == request.auth.uid
          && d.name == get(memberPath(lid)).data.name
          && d.createdAt == request.time
          && d.entryId is string
          && exists(entry)
          && get(entry).data.eventId == d.eventId
          && get(entry).data.playerId == d.playerId;
      }

      // Ritmo: comentarios (uno cada 3 s) y sugerencias (una por minuto) por persona. La hora se marca
      // en el mismo lote en limits/{uid}; ese documento no lo lee nadie (el buzón sigue siendo anónimo).
      function paced(field, secs) {
        let pace = /databases/$(database)/documents/leagues/$(lid)/limits/$(request.auth.uid);
        return getAfter(pace).data.get(field, null) == request.time
          && (!exists(pace)
              || get(pace).data.get(field, request.time - duration.value(secs + 1, 's')) < request.time - duration.value(secs, 's'));
      }
      // Cada marca dice qué comentario o nota la usó (un lote no mete muchos con una sola marca).
      function stamps(d) {
        return d.keys().hasOnly(['lastComment', 'commentId', 'lastSuggestion', 'suggestionId']);
      }

      allow get: if resource.data.visibility == 'public' || isMember(lid) || isSuper();
      allow list: if resource.data.visibility == 'public' || isSuper();
      // Cualquiera con cuenta crea su liga y queda como dueño (en el mismo lote).
      allow create: if signedIn()
        && validLeague(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(memberPath(lid)).data.role == 'owner';
      allow update: if isLeagueAdmin(lid)
        && validLeague(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSuper() || (isMember(lid) && role(lid) == 'owner');

      // Código de invitación vigente: solo lo ven los admins de la liga.
      match /private/{doc} {
        allow read, write: if isLeagueAdmin(lid);
      }

      match /players/{pid} {
        allow read: if canRead(lid);
        allow delete: if isLeagueAdmin(lid);
        // Cada cuenta juega con su propio jugador (uno solo): el miembro lo crea ya vinculado. Un admin crea
        // jugadores de la lista, o el suyo propio solo si todavía no tiene (dos teléfonos no le crean dos).
        allow create: if (isLeagueAdmin(lid) && (request.resource.data.get('uid', null) != request.auth.uid || myPlayer(lid) == null)) || (
          isMember(lid) && myPlayer(lid) == null
          && request.resource.data.keys().hasOnly(['name', 'averageOverride', 'uid', 'createdAt'])
          && validName(request.resource.data.name)
          && request.resource.data.averageOverride == null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(memberPath(lid)).data.playerId == pid
        );
        allow update: if isLeagueAdmin(lid)
          // Reclamar un jugador sin cuenta (junto con marcarlo en su membresía).
          || (isMember(lid) && myPlayer(lid) == null
              && resource.data.get('uid', null) == null
              && onlyChanged(['uid'])
              && request.resource.data.uid == request.auth.uid
              && getAfter(memberPath(lid)).data.playerId == pid)
          // Soltar su propio jugador (al salir de la liga).
          || (signedIn() && resource.data.get('uid', null) == request.auth.uid
              && onlyChanged(['uid'])
              && request.resource.data.uid == null);
      }

      match /events/{eid} {
        allow read: if canRead(lid);
        allow create, delete: if isLeagueAdmin(lid);
        // Asistencia: un miembro con jugador marca o quita solo su propio "voy".
        allow update: if isLeagueAdmin(lid) || (
          myPlayer(lid) != null
          && onlyChanged(['rsvp'])
          && request.resource.data.get('rsvp', {}).diff(resource.data.get('rsvp', {})).affectedKeys().hasOnly([myPlayer(lid)])
          && request.resource.data.get('rsvp', {}).get(myPlayer(lid), true) == true
        ) || (
          // En una práctica cualquier jugador suma un juego más (de uno en uno, hasta 10).
          myPlayer(lid) != null
          && resource.data.type == 'practica'
          && onlyChanged(['games'])
          && request.resource.data.games == resource.data.games + 1
          && request.resource.data.games <= 10
        );
      }

      match /entries/{id} {
        allow read: if canRead(lid);
        allow write: if isLeagueAdmin(lid);
        // Anotador: solo los pinos, las fotos y los cuadros de quienes ya están en el torneo.
        allow update: if isScorer(lid) && onlyChanged(['scores', 'photos', 'frames']);
      }

      // Fotos de los marcadores (comprimidas). Las sube un admin, un anotador o un miembro con jugador.
      match /photos/{id} {
        allow read: if canRead(lid);
        allow create: if isLeagueAdmin(lid) || (
          (myPlayer(lid) != null || isScorer(lid))
          && request.resource.data.keys().hasOnly(['data', 'width', 'height', 'eventId', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 750000
          && request.resource.data.data.matches('^data:image/jpeg;base64,.*')
          && (request.resource.data.eventId == null || exists(/databases/$(database)/documents/leagues/$(lid)/events/$(request.resource.data.eventId)))
          && request.resource.data.createdAt == request.time
        );
        allow update, delete: if isLeagueAdmin(lid);
      }

      // En vivo: los juegos que el jugador va anotando en su teléfono, para que todos los vean.
      // Solo publica los suyos (id = evento_jugador); no cuentan hasta que se envían y se aprueban.
      match /live/{id} {
        allow read: if canRead(lid);
        // En un torneo solo publica quien está inscrito; en una práctica, cualquier jugador de la liga.
        allow create, update: if myPlayer(lid) != null
          && id == request.resource.data.eventId + '_' + myPlayer(lid)
          && request.resource.data.keys().hasOnly(['eventId', 'playerId', 'scores', 'updatedAt'])
          && request.resource.data.playerId == myPlayer(lid)
          && okScores(request.resource.data.scores)
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/leagues/$(lid)/events/$(request.resource.data.eventId))
          && (get(/databases/$(database)/documents/leagues/$(lid)/events/$(request.resource.data.eventId)).data.type != 'torneo'
              || exists(/databases/$(database)/documents/leagues/$(lid)/entries/$(request.resource.data.eventId + '_' + myPlayer(lid))));
        allow delete: if resource == null
          || (myPlayer(lid) != null && resource.data.playerId == myPlayer(lid))
          || isLeagueAdmin(lid);
      }

      // Una reacción por persona y juego (id = participación_cuenta); cambiarla la vuelve a avisar.
      match /reactions/{id} {
        allow read: if canRead(lid);
        allow create, update: if socialOk(request.resource.data)
          && id == request.resource.data.entryId + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['entryId', 'eventId', 'playerId', 'uid', 'name', 'type', 'createdAt'])
          && request.resource.data.type in ['like', 'felicitar'];
        allow delete: if resource == null || (signedIn() && resource.data.uid == request.auth.uid) || isLeagueAdmin(lid);
      }

      // Comentarios: se escriben y se borran (el autor o un admin); no se editan.
      match /comments/{id} {
        allow read: if canRead(lid);
        allow create: if socialOk(request.resource.data)
          && request.resource.data.keys().hasOnly(['entryId', 'eventId', 'playerId', 'uid', 'name', 'text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && paced('lastComment', 3)
          && getAfter(/databases/$(database)/documents/leagues/$(lid)/limits/$(request.auth.uid)).data.get('commentId', null) == id;
        allow delete: if resource == null || (signedIn() && resource.data.uid == request.auth.uid) || isLeagueAdmin(lid);
      }

      match /limits/{uid} {
        allow create: if signedIn() && uid == request.auth.uid && isMember(lid)
          && stamps(request.resource.data)
          && request.resource.data.get('lastComment', request.time) == request.time
          && request.resource.data.get('lastSuggestion', request.time) == request.time;
        // Solo se pone la hora de ahora en lo que cambia (no se puede adelantar ni borrar la otra).
        allow update: if signedIn() && uid == request.auth.uid && isMember(lid)
          && stamps(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastComment', 'commentId', 'lastSuggestion', 'suggestionId'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastComment', 'commentId'])
              || request.resource.data.get('lastComment', null) == request.time)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSuggestion', 'suggestionId'])
              || request.resource.data.get('lastSuggestion', null) == request.time);
        // Nadie borra su propia marca (sería saltarse el ritmo); solo al borrar la liga.
        allow delete: if isLeagueAdmin(lid);
      }

      // Buzón de sugerencias: cualquier miembro deja una nota anónima (no se guarda quién la escribió);
      // la leen, marcan y borran los organizadores.
      match /suggestions/{id} {
        allow read: if isLeagueAdmin(lid);
        allow create: if isMember(lid)
          && request.resource.data.keys().hasOnly(['text', 'read', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && paced('lastSuggestion', 60)
          && getAfter(/databases/$(database)/documents/leagues/$(lid)/limits/$(request.auth.uid)).data.get('suggestionId', null) == id;
        allow update: if isLeagueAdmin(lid) && onlyChanged(['read']) && request.resource.data.read is bool;
        allow delete: if isLeagueAdmin(lid);
      }

      // Juegos que un miembro sube de SU jugador: quedan pendientes hasta que un admin los apruebe.
      // Van a un evento existente o a una fecha (se ponen en la práctica de ese día).
      match /submissions/{id} {
        allow read: if canRead(lid);
        allow create: if isLeagueAdmin(lid) || (
          myPlayer(lid) != null
          && request.resource.data.playerId == myPlayer(lid)
          && request.resource.data.keys().hasOnly(['playerId', 'eventId', 'date', 'scores', 'scanned', 'frames', 'photoId', 'status', 'note', 'createdAt'])
          && request.resource.data.status == 'pendiente'
          && request.resource.data.note == null
          && request.resource.data.scores.size() > 0
          && okScores(request.resource.data.scores)
          && (request.resource.data.scanned == null || okScores(request.resource.data.scanned))
          && (request.resource.data.get('frames', null) == null || request.resource.data.frames is map)
          && ((request.resource.data.eventId is string
                && exists(/databases/$(database)/documents/leagues/$(lid)/events/$(request.resource.data.eventId))
                && request.resource.data.get('date', null) == null)
              || (request.resource.data.eventId == null
                && request.resource.data.get('date', null) is string
                && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          // Con foto, o sin foto: la app le avisa que el admin puede no aceptarlo y el admin decide.
          && ((request.resource.data.photoId is string
                && existsAfter(/databases/$(database)/documents/leagues/$(lid)/photos/$(request.resource.data.photoId)))
              || request.resource.data.photoId == null)
          && request.resource.data.createdAt == request.time
        );
        // La foto se lee en segundo plano: lo que leyó la IA (y de qué fila de la foto) lo agrega el
        // jugador después de enviar, una sola vez, a su envío con foto que sigue pendiente (y nada más).
        allow update: if isLeagueAdmin(lid) || (
          myPlayer(lid) != null
          && resource.data.playerId == myPlayer(lid)
          && resource.data.status == 'pendiente'
          && resource.data.photoId != null
          && resource.data.scanned == null
          && onlyChanged(['scanned', 'scannedName'])
          && request.resource.data.scanned is list
          && request.resource.data.scanned.size() > 0
          && okScores(request.resource.data.scanned)
          && (request.resource.data.get('scannedName', null) == null
              || (request.resource.data.scannedName is string && request.resource.data.scannedName.size() <= 60))
        );
        allow delete: if isLeagueAdmin(lid);
      }
    }

    // ---------- Membresías: members/{liga}_{uid} ----------
    match /members/{id} {
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid
                                   || isMember(resource.data.leagueId) || isSuper());
      allow list: if signedIn() && (resource.data.uid == request.auth.uid
                                    || isMember(resource.data.leagueId) || isSuper());
      allow create: if signedIn()
        && id == request.resource.data.leagueId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['leagueId', 'uid', 'name', 'role', 'playerId', 'joinedAt', 'code'])
        && validName(request.resource.data.name)
        && request.resource.data.playerId == null
        && request.resource.data.joinedAt == request.time
        && (
          // Dueño: solo al crear la liga (en el mismo lote).
          (request.resource.data.role == 'owner'
            && !exists(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId))
            && getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.ownerUid == request.auth.uid)
          // Miembro: liga pública, o privada con un código de invitación válido.
          || (request.resource.data.role == 'member'
            && (league(request.resource.data.leagueId).visibility == 'public'
                || (request.resource.data.get('code', null) is string
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.leagueId == request.resource.data.leagueId)))
        );
      allow update: if
        // Dueño (o superadmin): permisos (admin y anotador, nunca el rol del dueño) y vincular jugador.
        (isLeagueOwner(resource.data.leagueId)
          && onlyChanged(['role', 'playerId', 'scorer'])
          && request.resource.data.get('scorer', false) is bool
          && (request.resource.data.role == resource.data.role
              || (resource.data.role != 'owner' && request.resource.data.role in ['admin', 'member'])))
        // Admins: solo vincular o desvincular el jugador de una cuenta.
        || (isLeagueAdmin(resource.data.leagueId) && onlyChanged(['playerId']))
        // Un admin deja de serlo por su cuenta (sigue como jugador).
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.role == 'admin'
            && onlyChanged(['role']) && request.resource.data.role == 'member')
        // El miembro se vincula con su jugador una sola vez (junto con marcar el jugador).
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.playerId == null
            && onlyChanged(['playerId'])
            && request.resource.data.playerId is string
            && getAfter(/databases/$(database)/documents/leagues/$(resource.data.leagueId)/players/$(request.resource.data.playerId)).data.uid == request.auth.uid);
      // Salir de la liga (el dueño no). El dueño saca a cualquiera; un admin solo a quien no tiene permisos
      // (ni admin ni anotador: sacarlo sería quitarle el permiso).
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid && resource.data.role != 'owner')
        || (isLeagueAdmin(resource.data.leagueId) && resource.data.role == 'member' && resource.data.get('scorer', false) != true)
        || isSuper()
        || (isMember(resource.data.leagueId) && role(resource.data.leagueId) == 'owner');
    }

    // ---------- Invitaciones: invites/{código} ----------
    match /invites/{code} {
      // Con el código (link o QR) se ve a qué liga invita; no se pueden listar.
      allow get: if true;
      allow create: if isLeagueAdmin(request.resource.data.leagueId)
        && request.resource.data.keys().hasOnly(['leagueId', 'leagueName', 'createdAt'])
        && getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)/private/invite).data.code == code;
      allow update: if isLeagueAdmin(resource.data.leagueId) && onlyChanged(['leagueName']);
      allow delete: if isLeagueAdmin(resource.data.leagueId);
    }
  }
}
