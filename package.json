{
  "name": "matchmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "vitest run -c vitest.sql.config.ts",
    "emulators": "npx -y firebase-tools@13 emulators:start --only auth,firestore --project demo-matchmate",
    "importar": "node scripts/importar-torneo.mjs",
    "test:reglas": "npx -y firebase-tools@13 emulators:exec --only firestore --project demo-bowlinx-reglas \"vitest run -c vitest.reglas.config.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "firebase": "^12.19.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uqr": "^0.1.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  }
}
