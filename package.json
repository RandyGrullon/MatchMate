{
  "name": "matchmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "vitest run -c vitest.sql.config.ts",
    "marca": "node scripts/icons/generate.mjs && node scripts/icons/splash.mjs",
    "supabase:start": "npx -y supabase@2 start",
    "supabase:stop": "npx -y supabase@2 stop",
    "supabase:reset": "npx -y supabase@2 db reset",
    "db:types": "npx -y supabase@2 gen types typescript --local > src/lib/db.types.ts",
    "test:migrar": "vitest run -c scripts/migrar/vitest.config.ts",
    "migrar": "node scripts/migrar/cli.mjs",
    "importar": "node scripts/importar-torneo.mjs",
    "badges:bundle": "node scripts/badges/bundle.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uqr": "^0.1.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  }
}
